{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "granodiorite",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "granodiorite.ferris.love", "custom_domain": true }],
  "triggers": {
    "crons": ["*/30 * * * *", "*/15 * * * *"]
  },
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS"
  },
  "r2_buckets": [
    {
      "binding": "MIRROR_BUCKET",
      "bucket_name": "granodiorite-apac"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "GRANODIORITE_KV",
      "id": "ed1f2607ce0b4cf68fd512c6aa76e7f7"
    }
  ],
  "d1_databases": [
    {
      "binding": "ANALYTICS_DB",
      "database_name": "granodiorite-analytics",
      "database_id": "538136cb-85d6-4d0d-b232-351e461ba59e"
    }
  ],
  "vars": {
    "PUBLIC_BUCKET_DOMAIN": "r2.granodiorite.ferris.love",
    "MIRROR_NAME": "Granodiorite"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
